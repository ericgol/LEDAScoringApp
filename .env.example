# LEDA Drone Scoring - Environment Variables
# Copy to .env and fill in values

# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_ENV=development

# Azure Storage (leave blank to use local file storage in dev)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_BLOB_ENDPOINT=
AZURE_STORAGE_CONTAINER_NAME=drone-images

# Azure Computer Vision (leave blank to skip CV analysis in dev)
AZURE_COMPUTER_VISION_ENDPOINT=
# Optional: key-based auth for local dev (managed identity used in Azure)
AZURE_COMPUTER_VISION_KEY=
